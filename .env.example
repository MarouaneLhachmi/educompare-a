# =============================================================================
# EduCompare AI — configuration
# Copiez ce fichier en « .env » puis renseignez vos propres valeurs.
# Le fichier .env ne doit JAMAIS etre versionne (il est deja dans .gitignore).
# =============================================================================

# --- Flask -------------------------------------------------------------------
# Cle de signature des cookies de session : mettez une valeur aleatoire longue.
FLASK_SECRET_KEY=changez-cette-valeur-par-une-chaine-aleatoire

# --- API Gemini (agents 2, 6, 7, 8 et 9) -------------------------------------
# Cle gratuite a creer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=colle_ta_cle_ici
GEMINI_MODEL=gemini-2.0-flash

# --- Modele de vectorisation (agent 4) ---------------------------------------
# false force le repli statistique LSA (utile hors ligne, sans telechargement).
USE_EMBEDDINGS=true
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Base de donnees MongoDB --------------------------------------------------
# Si le serveur est injoignable, l'application bascule automatiquement sur un
# stockage en memoire (les donnees sont alors perdues a l'arret du processus).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=educompare_ai

# --- Authentification Google (OAuth 2.0 / OpenID Connect) --------------------
# Console Google Cloud > API et services > Identifiants > ID client OAuth 2.0.
# URI de redirection autorisee a declarer :
#   http://127.0.0.1:5000/connexion/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresses promues automatiquement au role administrateur (separees par ,).
ADMIN_EMAILS=

# Connexion de demonstration sans Google (a passer a false en production).
ALLOW_DEMO_LOGIN=true

# --- Stockage ----------------------------------------------------------------
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_UPLOAD_MB=25
